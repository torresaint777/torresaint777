void setup()
{
  pinMode(8, OUTPUT);
  pinMode(9, OUTPUT);
  pinMode(10, OUTPUT);
}

void loop()
{ 
  // LED en pin 8
  digitalWrite(8,HIGH);
  delay(500);
   digitalWrite(8,LOW);
  delay(500);
    delay(500);
  
   // LED en pin 9
  digitalWrite(9,HIGH);
  delay(500);
   digitalWrite(9,LOW);
  delay(500);
    delay(500);
  
   // LED en pin 10
  digitalWrite(10,HIGH);
  delay(500);
   digitalWrite(10,LOW);
  delay(500);
    delay(500);
 }